{
  "name": "hakimi-pet",
  "version": "0.1.0",
  "description": "Hakimi Pet (哈基米桌宠) — Independent Electron desktop pet with procedural + .webm animations, spring-throw physics, and dsh-pet asset compatibility.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/renderer/renderer.ts --bundle --platform=browser --outfile=dist/renderer/renderer.js",
    "start": "npm run build && node scripts/launch.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "export:dsh-pack": "node scripts/export-dsh-pack.mjs"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "hakimi",
    "dsh-pet",
    "chibi",
    "anime"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^2.1.8",
    "electron": "^33.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
